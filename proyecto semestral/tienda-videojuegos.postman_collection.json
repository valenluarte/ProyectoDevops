{
  "info": {
    "name": "Tienda - Backend",
    "description": "Colección de endpoints para ventas y despacho",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "host_ventas",
      "value": "http://localhost:3002"
    },
    {
      "key": "host_despachos",
      "value": "http://localhost:3003"
    }
  ],
  "item": [
    {
      "name": "Ventas",
      "item": [
        {
          "name": "Health - Ventas",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{host_ventas}}/api/ventas/health",
              "host": [
                "{{host_ventas}}"
              ],
              "path": [
                "api",
                "ventas",
                "health"
              ]
            }
          }
        },
        {
          "name": "Listar ventas",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{host_ventas}}/api/ventas",
              "host": [
                "{{host_ventas}}"
              ],
              "path": [
                "api",
                "ventas"
              ]
            }
          }
        },
        {
          "name": "Obtener venta por ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{host_ventas}}/api/ventas/1",
              "host": [
                "{{host_ventas}}"
              ],
              "path": [
                "api",
                "ventas",
                "1"
              ]
            }
          }
        },
        {
          "name": "Crear venta",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cliente_id\": 1,\n  \"total\": 59990,\n  \"estado\": \"REGISTRADA\",\n  \"detalles\": [\n    {\n      \"videojuego_id\": 1,\n      \"nombre_videojuego\": \"The Legend of Zelda Tears of the Kingdom\",\n      \"plataforma\": \"Nintendo Switch\",\n      \"cantidad\": 1,\n      \"precio_unitario\": 59990,\n      \"subtotal\": 59990\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{host_ventas}}/api/ventas",
              "host": [
                "{{host_ventas}}"
              ],
              "path": [
                "api",
                "ventas"
              ]
            }
          }
        },
        {
          "name": "Actualizar estado de venta",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"estado\": \"PAGADA\"\n}"
            },
            "url": {
              "raw": "{{host_ventas}}/api/ventas/1/estado",
              "host": [
                "{{host_ventas}}"
              ],
              "path": [
                "api",
                "ventas",
                "1",
                "estado"
              ]
            }
          }
        },
        {
          "name": "Eliminar venta",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{host_ventas}}/api/ventas/4",
              "host": [
                "{{host_ventas}}"
              ],
              "path": [
                "api",
                "ventas",
                "4"
              ]
            }
          }
        }
      ]
    },
